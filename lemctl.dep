SPATH := $($(LEMCTL)_SRC_PATH)
LEMCTL_SOURCE_PATH := $(SPATH)/../libsai-grpc/lemming
DEP_FILES := $(SONIC_COMMON_FILES_LIST) $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES += $(PLATFORM_PATH)/lemctl.mk $(PLATFORM_PATH)/lemctl.dep
DEP_FILES += $(addprefix $(SPATH)/,$(shell git -C $(SPATH) ls-files .))

$(LEMCTL)_CACHE_MODE := GIT_CONTENT_SHA
$(LEMCTL)_DEP_FLAGS := $(SONIC_COMMON_FLAGS_LIST)
$(LEMCTL)_DEP_FILES := $(DEP_FILES)
$(LEMCTL)_SMDEP_PATHS := $(LEMCTL_SOURCE_PATH)
$(LEMCTL)_SMDEP_FILES := $(addprefix $(LEMCTL_SOURCE_PATH)/,$(shell git -C $(LEMCTL_SOURCE_PATH) ls-files | grep -v " "))
